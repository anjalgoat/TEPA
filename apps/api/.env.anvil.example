# Copy to .env.anvil, fill with local-only values, and export it before running npm commands.
# Never copy keys or contract addresses from the Base Sepolia .env.
APP_ENV=local
PORT=3000
DATABASE_URL=postgresql://127.0.0.1:5432/tepa_hackathon
WEB_ORIGIN=http://localhost:5173
CHAIN_ID=31337
CHAIN_RPC_URL=http://127.0.0.1:8545
BASE_SEPOLIA_RPC_URL=
MOCK_IDENTITY_PROVIDER=true
MOCK_INTERMEDIARY=true
REAL_MONEY_ENABLED=false
SECONDARY_TRANSFERS_ENABLED=false

# Leave contract addresses empty for demo:reset. Fill them after local deployment.
TEPA_TOKEN_ADDRESS=
TEST_USDC_ADDRESS=
TEPA_TOKEN_CODE_HASH=
TEST_USDC_CODE_HASH=

# Two distinct local-only browser wallet addresses.
DEMO_HOLDER_A_ADDRESS=
DEMO_HOLDER_B_ADDRESS=

# Local-only operator key(s). One signer may hold multiple demo roles; disclose that concentration.
DEPLOYER_PRIVATE_KEY=
ISSUANCE_PRIVATE_KEY=
DISTRIBUTION_PRIVATE_KEY=
SETTLEMENT_PRIVATE_KEY=
COMPLIANCE_SIGNER_ADDRESS=
ISSUER_SIGNER_ADDRESS=
PAUSER_SIGNER_ADDRESS=
RECOVERY_SIGNER_ADDRESS=
DEMO_ADMIN_ADDRESS=
DISTRIBUTION_SIGNER_ADDRESS=
SETTLEMENT_SIGNER_ADDRESS=
EXPECTED_CHAIN_ID=31337
